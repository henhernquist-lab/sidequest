# Force LF on text Unity/code files so line endings stay consistent between
# this Codespace (Linux) and the Mac running the Unity Editor.
* text=auto eol=lf

*.cs text eol=lf diff=csharp
*.cginc text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Unity YAML-based asset files: route merges through Unity's Smart Merge
# (UnityYAMLMerge) instead of a plain line-based diff/merge, which otherwise
# corrupts scenes/prefabs on conflict. Requires UnityYAMLMerge to be
# configured as a git merge driver on whichever machine performs the merge
# (typically the Editor machine) — see README.md.
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.physicsMaterial2D text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.mask text eol=lf merge=unityyamlmerge
*.meta text eol=lf merge=unityyamlmerge

# Unity project/settings YAML files, same treatment.
ProjectSettings/*.asset text eol=lf merge=unityyamlmerge
ProjectSettings/*.unity text eol=lf merge=unityyamlmerge

# Binary assets — do not run text diffing/merging on these.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.tif binary
*.tiff binary
*.gif binary
*.exr binary
*.hdr binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.exe binary
*.unitypackage binary
